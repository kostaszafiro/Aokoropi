            {
                "id": "facilities-intro",
                "name": "Facilities \u00b7 Intro",
                "blocks": [
                    {
                        "id": "fac-intro-1",
                        "type": "raw",
                        "data": {
                            "code": "<div class=\"facilities-intro\">\n  <h3>\u0397 \u0388\u03b4\u03c1\u03b1 \u03bc\u03b1\u03c2</h3>\n\n  <p>\n  \u0397 \u0388\u03b4\u03c1\u03b1 \u03bc\u03b1\u03c2\n\u039f \u0391\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03cc\u03c2 \u038c\u03bc\u03b9\u03bb\u03bf\u03c2 \u039a\u03bf\u03c1\u03c9\u03c0\u03af\u03bf\u03c5 1903 \u03b1\u03b3\u03c9\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03ba\u03b1\u03b9 \u03c0\u03c1\u03bf\u03c0\u03bf\u03bd\u03b5\u03af\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf <span class=\"stadium-name\">\u0394\u03b7\u03bc\u03bf\u03c4\u03b9\u03ba\u03cc \u03a3\u03c4\u03ac\u03b4\u03b9\u03bf \u039a\u03bf\u03c1\u03c9\u03c0\u03af\u03bf\u03c5 \u00ab\u0391\u03bd\u03c4\u03ce\u03bd\u03b7\u03c2 \u03a0\u03c1\u03af\u03c6\u03c4\u03b7\u03c2\u00bb</span>, \u03c4\u03bf \u03bf\u03c0\u03bf\u03af\u03bf \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03c4\u03bf \u03b2\u03b1\u03c3\u03b9\u03ba\u03cc \u03c0\u03bf\u03b4\u03bf\u03c3\u03c6\u03b1\u03b9\u03c1\u03b9\u03ba\u03cc \u03c3\u03b7\u03bc\u03b5\u03af\u03bf \u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03cc\u03bb\u03b7\u03c2.\n\n\u03a4\u03bf \u03b3\u03ae\u03c0\u03b5\u03b4\u03bf \u03c6\u03b9\u03bb\u03bf\u03be\u03b5\u03bd\u03b5\u03af \u03b1\u03b3\u03ce\u03bd\u03b5\u03c2 \u03c0\u03c1\u03c9\u03c4\u03b1\u03b8\u03bb\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03ba\u03b1\u03b9 \u03b4\u03c1\u03b1\u03c3\u03c4\u03b7\u03c1\u03b9\u03cc\u03c4\u03b7\u03c4\u03b5\u03c2 \u03b1\u03ba\u03b1\u03b4\u03b7\u03bc\u03b9\u03ce\u03bd, \u03b5\u03bd\u03ce \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03ad\u03bd\u03b1\u03bd \u03c7\u03ce\u03c1\u03bf \u03cc\u03c0\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b7\u03bc\u03b5\u03c1\u03b9\u03bd\u03ac \u03b6\u03b5\u03b9 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03c0\u03c4\u03cd\u03c3\u03c3\u03b5\u03c4\u03b1\u03b9 \u03c4\u03bf \u03c0\u03bf\u03b4\u03cc\u03c3\u03c6\u03b1\u03b9\u03c1\u03bf \u03c3\u03c4\u03bf \u039a\u03bf\u03c1\u03c9\u03c0\u03af. \u03a0\u03c1\u03cc\u03ba\u03b5\u03b9\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03b4\u03b7\u03bc\u03bf\u03c4\u03b9\u03ba\u03ae \u03b5\u03b3\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c0\u03bf\u03c5 \u03b1\u03bd\u03ae\u03ba\u03b5\u03b9 \u03c3\u03c4\u03b9\u03c2 \u03b1\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b4\u03bf\u03bc\u03ad\u03c2 \u03c4\u03bf\u03c5 \u0394\u03ae\u03bc\u03bf\u03c5 \u039a\u03c1\u03c9\u03c0\u03af\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03be\u03c5\u03c0\u03b7\u03c1\u03b5\u03c4\u03b5\u03af  \u03c3\u03c5\u03bb\u03bb\u03cc\u03b3\u03bf\u03c5\u03c2 \u03ba\u03b1\u03b9 \u03bd\u03ad\u03bf\u03c5\u03c2 \u03b1\u03b8\u03bb\u03b7\u03c4\u03ad\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ae\u03c2.\n \n  </p>\n</div>"
