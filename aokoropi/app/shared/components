                        "id": "prog-card-1",
                        "type": "raw",
                        "data": {
                            "code": "<div class=\"programs-grid\">\n\n  <div class=\"prog-card\" data-age=\"\u039a7\">\n    <div class=\"prog-age\">5 \u2013 6</div>\n    <div class=\"prog-name\">\u039a7 \u00b7 Under 7</div>\n    <div class=\"prog-desc\">\n      <div class=\"prog-detail\">\n        <span class=\"prog-detail-label\">\u03a3\u03c4\u03cc\u03c7\u03bf\u03c2:</span>\n        \u03a0\u03c1\u03ce\u03c4\u03b7 \u03b5\u03c0\u03b1\u03c6\u03ae \u03bc\u03b5 \u03c4\u03bf \u03c0\u03bf\u03b4\u03cc\u03c3\u03c6\u03b1\u03b9\u03c1\u03bf \u03bc\u03ad\u03c3\u03b1 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9\n      </div>\n      <div class=\"prog-detail\">\n        <span class=\"prog-detail-label\">\u0388\u03bc\u03c6\u03b1\u03c3\u03b7:</span>\n        \u039a\u03b9\u03bd\u03b7\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1, \u03c3\u03c5\u03bd\u03c4\u03bf\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2, \u03b5\u03be\u03bf\u03b9\u03ba\u03b5\u03af\u03c9\u03c3\u03b7 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03bc\u03c0\u03ac\u03bb\u03b1, \u03b4\u03b9\u03b1\u03c3\u03ba\u03ad\u03b4\u03b1\u03c3\u03b7\n      </div>\n    </div>\n    <div class=\"prog-tags\">\n      <span class=\"prog-tag\">\u039a\u03b9\u03bd\u03b7\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1</span>\n      <span class=\"prog-tag\">\u03a3\u03c5\u03bd\u03c4\u03bf\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2</span>\n      <span class=\"prog-tag\">\u0394\u03b9\u03b1\u03c3\u03ba\u03ad\u03b4\u03b1\u03c3\u03b7</span>\n    </div>\n  </div>\n\n  <div class=\"prog-card\" data-age=\"\u039a9\">\n    <div class=\"prog-age\">7 \u2013 8</div>\n    <div class=\"prog-name\">\u039a9 \u00b7 Under 9</div>\n    <div class=\"prog-desc\">\n      <div class=\"prog-detail\">\n        <span class=\"prog-detail-label\">\u03a3\u03c4\u03cc\u03c7\u03bf\u03c2:</span>\n        \u0391\u03bd\u03ac\u03c0\u03c4\u03c5\u03be\u03b7 \u03b2\u03b1\u03c3\u03b9\u03ba\u03ce\u03bd \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ce\u03bd \u03b4\u03b5\u03be\u03b9\u